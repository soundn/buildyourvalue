{
  "name": "@byv/api",
  "version": "0.1.0",
  "private": true,
  "description": "Build Your Value API: scoring, matching, learning paths, CV improvement, admin review queue.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:remote": "NODE_USE_ENV_PROXY=1 tsx scripts/remote-eligibility-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@byv/core": "0.1.0",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
