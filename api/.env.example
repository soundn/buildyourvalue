PORT=4000
# Comma-separated origins allowed to call the API (frontend and admin dev servers).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional. When set, POST /v1/cv/improve calls Claude through the Anthropic SDK.
# Without it the API uses the deterministic rewrite rules from @byv/core.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5-5. The plan's cost model assumes a
# cheaper model such as claude-haiku-5-5 for bulk reranking; set it here to test that.
ANTHROPIC_MODEL=
