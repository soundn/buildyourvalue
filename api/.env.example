# Port the Hono API listens on.
PORT=4000
# Comma-separated browser origins allowed by CORS (frontend on 3000, admin on 3001).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional. Enables Claude in POST /v1/cv/improve; without it the deterministic rules
# fallback in @byv/core answers, and it also answers if the model refuses or the call fails.
ANTHROPIC_API_KEY=
# Legacy override for both model tiers below; leave empty and set the tier variables instead.
ANTHROPIC_MODEL=
# Write tier (ADR-0003): CV parsing, rewriting, tailoring, cover letters, interview grading.
ANTHROPIC_MODEL_WRITE=claude-sonnet-5-5
# Bulk tier (ADR-0003): digest reranking, scam triage, verification. Retried once on the
# write model when Haiku refuses, because Haiku 5.5 has no server-side refusal fallback.
ANTHROPIC_MODEL_BULK=claude-haiku-5-5

# Embedding model for jobs, profile summaries and courses (ADR-0007, ADR-0013);
# text-embedding-3-small at 1536 dimensions is the named alternative.
EMBEDDING_MODEL=voyage-4-lite
# Vector dimensions; migrations read this for halfvec(<dims>) columns.
EMBEDDING_DIMS=1024
VOYAGE_API_KEY=

# Phase 1 services (not read by the prototype yet; documented so accounts can be prepared).
# Supabase project in London (ADR-0004, ADR-0009). Service role key is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Application-level encryption for phone, email and identifiers (ADR-0009): 32-byte keys, base64.
ENCRYPTION_KEY=
HASH_KEY=
# Email through Resend (ADR-0005, ADR-0012); the digest sends from a dedicated subdomain.
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=Ladda <hello@useladda.com>
EMAIL_FROM_DIGEST=Ladda Jobs <digest@mail.useladda.com>
# Paystack: test keys only until CAC and bank verification are complete.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Termii for SMS OTP through Supabase's Send SMS Hook (DND route, registered sender ID).
TERMII_API_KEY=
TERMII_SENDER_ID=
